<Window x:Class="ApartmentPlans.ExportModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:res="clr-namespace:ApartmentPlans.Resources"
        xmlns:local="clr-namespace:ApartmentPlans" xmlns:viewmodels="clr-namespace:ApartmentPlans.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainVm}"
        xmlns:auxiliary="clr-namespace:ApartmentPlans.AuxiliaryСlasses"
        mc:Ignorable="d"
        Title="Плагин &quot;Планы квартир&quot; модуль экспорта листов" 
        Height="545" Width="680" Background="#FFE6E6E6">
    <Window.Resources>
        <auxiliary:ColumnWidthToComboBoxWidthConverter x:Key="ColumnWidthToComboBoxWidthConverter"/>
        <auxiliary:WidthConverter x:Key="WidthConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="201*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="325*"/>
            <ColumnDefinition Width="325*"/>
        </Grid.ColumnDefinitions>

        <TextBox Margin="5,4,0,0" TextWrapping="Wrap" 
                 VerticalAlignment="Top" 
                 Text="{x:Static res:FileResources.Search}"
                 GotFocus="TextBox_GotFocus" 
                 LostFocus="TextBox_LostFocus" TextChanged="TextBoxSearchViews_TextChanged"/>
        <ListView ItemsSource="{Binding ViewsSheet}" 
                  Grid.Column="0" Margin="5,25,0,0" Grid.Row="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="303">
                        <GridViewColumn.Header>
                            <Grid>

                                <TextBlock Text="{x:Static res:FileResources.Views}" 
                                           Grid.ColumnSpan="2" 
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="270" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Grid.Column="0"/>
                                    <TextBlock Text="{Binding View.Name}" 
                                               Grid.Column="1"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Command="{Binding ExportCommand}"
                Grid.Column="1"
                Grid.Row="1"
                Content="{x:Static res:FileResources.Start}"
                VerticalAlignment="Top"
                Background="White" Margin="0,8,0,0" HorizontalAlignment="Center" Width="120"/>
        <TabControl Grid.Column="1">
            <TabItem Header="Выгрузка">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid Background="#FFE5E5E5" Grid.Column="1">
                            <Border Background="White" CornerRadius="5" Margin="6,5,8,10"/>
                            <Grid>
                                <ComboBox Margin="174,50,20,0" Height="22" VerticalAlignment="Top"
                            IsEditable="True"
                            IsTextSearchEnabled="False" 
                            StaysOpenOnEdit="True"
                            ItemsSource="{Binding FilteredNameProjectParameters.View}"
                            DisplayMemberPath="Name"
                            Text="{Binding FilterNameProjectText, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectedNameProjectParameter, Mode=TwoWay}"
                                  GotFocus="ComboBox_GotFocus"
                                          MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WidthConverter}}"/>
                                <TextBlock x:Name="nameProject"
                        
                        Text="{x:Static res:FileResources.NameProject}" 
                        Margin="10,53,0,0" 
                        TextWrapping="Wrap" 
                        Height="16" 
                        VerticalAlignment="Top" HorizontalAlignment="Left" Width="161"/>
                                <TextBlock x:Name="nameCase"
                            
                            Margin="10,88,0,0" 
                            TextWrapping="Wrap" 
                            Height="16" 
                            VerticalAlignment="Top"
                            Text="{x:Static res:FileResources.NameCase}" HorizontalAlignment="Left" Width="161"/>
                                <TextBlock x:Name="nameSection"
                            
                            Margin="10,124,0,0" 
                            TextWrapping="Wrap"
                            Height="18" 
                            VerticalAlignment="Top" 
                            Text="{x:Static res:FileResources.NameSection}" HorizontalAlignment="Left" Width="161"/>
                                <TextBlock x:Name="nameFloor"
                            
                            Margin="10,164,0,0" 
                            TextWrapping="Wrap" 
                            Height="18" 
                            VerticalAlignment="Top"
                            Text="{x:Static res:FileResources.NameFloor}" HorizontalAlignment="Left" Width="137"/>
                                <TextBlock x:Name="pathToSave"
                        
                        Text="{x:Static res:FileResources.PathToSave}" 
                        Margin="10,201,0,0" 
                        TextWrapping="Wrap" 
                        Height="16" 
                        VerticalAlignment="Top" HorizontalAlignment="Left" Width="161"/>
                                <TextBlock x:Name="path"
                        Text="{Binding PathToSave}" 
                        Margin="10,235,22,0" 
                        TextWrapping="Wrap" 
                        Height="44" 
                        VerticalAlignment="Top"/>
                                <ComboBox Margin="174,86,20,0" Height="22" VerticalAlignment="Top"
                            IsEditable="True"
                            IsTextSearchEnabled="False" 
                            StaysOpenOnEdit="True"
                            ItemsSource="{Binding FilteredNamesCaseParameters.View}"
                            DisplayMemberPath="Name"
                            Text="{Binding FilterNamesCaseText, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectedNameCaseParameter, Mode=TwoWay}"
                            LostFocus="NamesCaseParameterComboBox_LostFocus"
                          GotFocus="ComboBox_GotFocus"
                                          MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WidthConverter}}"/>
                                <ComboBox Margin="174,123,20,0" Height="22" VerticalAlignment="Top"
                            IsEditable="True"
                            IsTextSearchEnabled="False" 
                            StaysOpenOnEdit="True"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding FilteredNamesSectionParameters.View}"
                            Text="{Binding FilterNamesSectionText, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectedNameSectionParameter, Mode=TwoWay}"
                            LostFocus="NamesSectionParameterComboBox_LostFocus"
                          GotFocus="ComboBox_GotFocus"
                                          MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WidthConverter}}"/>
                                <ComboBox Margin="174,162,20,0" Height="22" VerticalAlignment="Top"
                            IsEditable="True"
                            IsTextSearchEnabled="False" 
                            StaysOpenOnEdit="True"
                            ItemsSource="{Binding FilteredNamesFloorParameters.View}"
                            DisplayMemberPath="Name"
                            Text="{Binding FilterNamesFloorText, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectedNameFloorParameter, Mode=TwoWay}"
                            LostFocus="NamesFloorParameterComboBox_LostFocus"
                            GotFocus="ComboBox_GotFocus"
                                          MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WidthConverter}}"/>
                                <Button 
                                Content="{x:Static res:FileResources.Choose}" 
                                Margin="174,198,20,0" 
                                VerticalAlignment="Top"
                                Command="{Binding СhoosePathToSaveCommand}"/>
                                <ListView ItemsSource="{Binding ItemsSchedule}" Margin="10,279,10,15">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Колонка" Width="120">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Параметр" Width="160" x:Name="ParameterColumn">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox
                            Width="{Binding ElementName=ParameterColumn, Path=ActualWidth, Converter={StaticResource ColumnWidthToComboBoxWidthConverter}, ConverterParameter=13}"
                            IsEditable="True"
                            IsTextSearchEnabled="False"
                            StaysOpenOnEdit="True"
                            ItemsSource="{Binding FilteredObjectParameters.View}"
                            DisplayMemberPath="Name"
                            Text="{Binding FilterObjectText, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectedObjectParameter, Mode=TwoWay}"
                            LostFocus="SortParameterComboBox_LostFocus"
                            GotFocus="ComboBox_GotFocus"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock x:Name="nameProject_Копировать"
                        
                    Margin="110,19,63,0" 
                    TextWrapping="Wrap" 
                    Height="16" 
                    VerticalAlignment="Top"><Run Language="ru-ru" Text="Настройка выгрузки"/></TextBlock>

                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Пресет">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid Background="#FFE5E5E5">
                        <Border Background="White" CornerRadius="5" Margin="6,5,8,4"/>
                        <Button Margin="180,28,20,0" 
                            Height="21.96" 
                            VerticalAlignment="Top"
                            Content="{x:Static res:FileResources.UploadSettings}"
                            Command="{Binding UploadSettingsCommand}"/>
                        <Button Margin="180,65,20,0" 
                            Height="21.96" 
                            VerticalAlignment="Top"
                            Content="{x:Static res:FileResources.SaveSettings}"
                            Command="{Binding SaveSettingsCommand}"/>
                        <TextBlock Text="{x:Static res:FileResources.UploadSettingsLabel}" 
                               Margin="10,28,0,0" 
                        TextWrapping="Wrap" 
                        Height="34" 
                        VerticalAlignment="Top" HorizontalAlignment="Left" Width="161"/>
                        <TextBlock Text="{x:Static res:FileResources.SaveSettingsLabel}" Margin="10,65,0,0" 
                        TextWrapping="Wrap" Height="34" 
                        VerticalAlignment="Top" HorizontalAlignment="Left" Width="161"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
